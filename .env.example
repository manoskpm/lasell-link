# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git에 올라가지 않아요)
# 배포 환경에서는 같은 이름으로 "환경 비밀값"에 넣으세요.

DATABASE_URL="file:./dev.db"

# 운영자 로그인 아이디. 쉼표로 여러 개 가능. 코드에 적지 말 것
PLATFORM_LOGIN_IDS=""

# 운영자 계정을 처음 만들 때(/platform/setup) 쓰는 1회용 설치 코드.
# 16자 이상 무작위 문자열. 운영자 계정을 다 만든 뒤에는 지워도 됨
PLATFORM_SETUP_CODE=""

# 입금 알림 자동 확인(6단계)에서 알림 원문의 금액·입금자명을 읽어내는 데 씀 (Haiku 4.5).
# console.anthropic.com 에서 발급. 안 넣으면 알림 자동 확인 기능이 꺼진 것처럼 동작함
# (알림은 저장되지만 자동으로는 못 읽어서 셀러가 직접 확인해야 함)
ANTHROPIC_API_KEY=""
