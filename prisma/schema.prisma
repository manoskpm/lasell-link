// 라셀링크 (라이브셀러 연결) 스키마
// 참고: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// 택배사가 제공하는 대량접수 엑셀 양식과 컬럼 매핑 정보
model CourierTemplate {
  id        Int      @id @default(autoincrement())
  /// 상점 1개만 운영하는 지금은 항상 그 상점을 가리킴.
  /// 여러 상점으로 넓힐 때 이 칸 하나로 상점별 양식을 나눌 수 있음
  shopId    Int?
  name      String
  filePath  String // 서버에 저장된 양식 파일 경로 (공개 폴더 아님)
  sheetName String?
  headerRow Int      @default(1)
  startRow  Int      @default(2)
  mapping   String   @default("{}") // { 필드명: 엑셀 열 번호 } JSON
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id            Int      @id @default(autoincrement())
  loginId       String   @unique // 로그인 아이디 (이메일 또는 아이디)
  password      String // scrypt 해시
  name          String
  phone         String
  zipcode       String?
  address       String?
  addressDetail String?
  role          String    @default("CUSTOMER") // CUSTOMER | SELLER (운영자는 DB 역할이 아니라 아래 조건으로 판단)
  /// /platform/setup(1회용 설치 코드)으로 만든 계정만 true.
  /// 운영자 = 이 값이 true 이면서 로그인 아이디가 환경 비밀값 PLATFORM_LOGIN_IDS 에 있을 때.
  /// 비밀값에 아이디를 나중에 추가해도, 그 아이디를 먼저 쓰던 손님이 운영자가 되지 않게 막는 장치.
  platformAccount Boolean @default(false)
  /// 다음 배송에 쓰겠다고 골라둔 쿠폰. 배송으로 넘어갈 때 적용되고 비워짐
  pendingCouponId Int?
  followedAt    DateTime? // 단골 등록일. null이면 단골 아님
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  pendingCoupon Coupon?  @relation("PendingCoupon", fields: [pendingCouponId], references: [id], onDelete: SetNull)

  sessions    Session[]
  cartItems   CartItem[]
  orders      Order[]
  settlements Settlement[]

  sellerApplications SellerApplication[] @relation("Applicant")
  reviewedApplications SellerApplication[] @relation("Reviewer")
  shop               Shop?
  depositorAliases   DepositorAlias[]
}

/// 셀러 신청서. 거절된 뒤 다시 신청하면 새 행이 생겨 이력이 남는다
model SellerApplication {
  id           Int       @id @default(autoincrement())
  userId       Int
  /// 대기 PENDING | 승인 APPROVED | 거절 REJECTED
  status       String    @default("PENDING")
  shopName     String
  ownerName    String
  phone        String
  /// 판매 채널 (쉼표로 구분: 유튜브,인스타그램,...)
  channels     String
  channelUrl   String?
  mainProducts String
  /// 사업자등록번호 숫자 10자리 (하이픈 없이). 진위는 운영자가 승인 화면에서 직접 확인
  bizNumber    String
  message      String?
  rejectReason String?
  reviewedById Int?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user       User  @relation("Applicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("Reviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

/// 셀러의 상점. 승인하면 생긴다.
/// 지금은 상품·주문에 상점 구분이 없어서 상점은 1개까지만 운영한다 (두 번째 승인은 막힘).
/// 3단계에서 상점 설정(상호·계좌·배송비 등)이 이 표로 옮겨온다.
model Shop {
  id            Int       @id @default(autoincrement())
  /// 나중에 손님 주소(/s/주소)로 쓸 고유 이름
  slug          String    @unique
  ownerUserId   Int       @unique
  name          String
  /// 영업 중 ACTIVE | 정지 SUSPENDED
  status        String    @default("ACTIVE")
  suspendReason String?
  suspendedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // ── 여기부터는 셀러가 직접 관리하는 상점 정보 (예전 Setting 모델에서 옮겨옴) ──
  logoUrl         String?
  ownerName       String?
  contactPhone    String?
  kakaoChannelUrl String? // 예: http://pf.kakao.com/_abcdef
  chatUrl         String? // 카카오 오픈채팅 등 기타 문의 링크
  bankAccount     String? // 예: 카카오뱅크 3333-01-1234567 홍길동
  /// 계좌를 마지막으로 바꾼 시각. 바뀐 직후 손님 화면에 안내를 보여주는 데 씀
  bankAccountChangedAt DateTime?
  noticeText      String?

  /// 방송 종료 후 연장판매 마감 시각. null이면 연장판매 중이 아님
  saleClosesAt DateTime?
  /// 이 수량 이하로 남으면 '품절임박'으로 강조하고 맨 위로 올림.
  /// 운영자가 정한 범위(PlatformSetting.lowStockAtMin~Max) 안에서만 정할 수 있음
  lowStockAt   Int       @default(3)

  // 배송비 정책
  shippingFee      Int @default(3000)
  /// 택배사에 실제 지불하는 건당 단가. 무료배송이어도 이 비용은 그대로 나감
  courierCost      Int @default(0)
  freeShippingOver Int @default(0) // 0이면 무료배송 조건 없음

  // 택배 송장의 '보내는분' 정보
  senderZipcode       String?
  senderAddress       String?
  senderAddressDetail String?

  // 택배사 접수 정보 (비밀번호는 저장하지 않음).
  // 택배사 자체(사이트 주소·배송조회 주소)는 운영자가 관리하는 Courier 목록에서 고름
  courierId           Int?
  courierLoginId      String?
  courierCustomerCode String?

  /// 입금 기한 설정. "HOURS" = 청구 후 N시간, "FIXED_TIME" = 매일 정해진 시각까지
  paymentDueRule      String  @default("HOURS")
  paymentDueHours     Int     @default(24)
  paymentDueFixedTime String? // "HH:mm" (24시간제)

  owner   User     @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  courier Courier? @relation(fields: [courierId], references: [id], onDelete: SetNull)

  depositorAliases DepositorAlias[]
}

/// "이 입금자명은 이 손님이다"라는 셀러의 확인을 기억해뒀다가,
/// 다음에 같은 이름으로 입금되면 자동으로 같은 손님과 매칭한다.
/// 상점 하나에 같은 입금자명은 손님 한 명만 가리킬 수 있다.
model DepositorAlias {
  id            Int      @id @default(autoincrement())
  shopId        Int
  depositorName String
  userId        Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, depositorName])
}

/// 운영자가 관리하는 택배사 목록. 접수 사이트·배송조회 주소는 셀러가 실수로
/// 잘못 적으면 조회가 깨지거나 낚시 링크가 될 수 있어 운영자만 고칠 수 있게 함
model Courier {
  id                  Int      @id @default(autoincrement())
  name                String
  siteUrl             String?
  /// {{번호}} 자리에 운송장번호가 들어감
  trackingUrlTemplate String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  shops Shop[]
}

/// 운영자만 바꿀 수 있는 운영 방침 (항상 id = 1 한 줄만 사용)
model PlatformSetting {
  id                     Int      @id @default(1)
  /// 꺼두면 손님이 셀러 신청서를 낼 수 없음 (심사가 밀릴 때 잠깐 닫아둘 용도)
  acceptingApplications  Boolean  @default(true)
  /// 셀러가 상점 설정에서 정하는 '품절임박' 기준 수량의 허용 범위
  lowStockAtMin          Int      @default(1)
  lowStockAtMax          Int      @default(10)
  /// 셀러가 곤란할 때 안내에 쓰이는 운영자 연락처 (둘 다 비워둘 수 있음)
  operatorContactKakaoUrl String?
  operatorContactPhone   String?
  updatedAt              DateTime @updatedAt
}

/// 운영자가 한 중요한 일의 기록 (승인·거절·정지·재개 등).
/// 계좌번호 같은 민감한 값은 detail 에 넣지 않는다
model AuditLog {
  id          Int      @id @default(autoincrement())
  actorUserId Int?
  action      String
  targetType  String
  targetId    Int?
  detail      String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

/// 지금 접속해 있는 사람을 세기 위한 기록. 손님 화면이 주기적으로 신호를 보냄.
/// 지금은 상점이 하나라 전체 = 내 상점이지만, 여러 셀러를 받을 때는
/// 반드시 shopId를 추가해 상점별로 나눠 세야 한다.
model Presence {
  id         String   @id // 방문자 임시 식별값 (브라우저 탭마다 하나)
  userId     Int?
  lastSeenAt DateTime

  @@index([lastSeenAt])
}

model Session {
  id        String   @id
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  price       Int // 정가
  salePrice   Int? // 특가(할인가). 있으면 이 가격으로 판매
  cost        Int      @default(0)
  category    String   @default("의류") // 의류 | 악세서리 | 잡화
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)

  /// 라이브 오픈 상태. false면 미리 등록만 해두고 손님 화면에는 안 보임
  isOpen   Boolean   @default(false)
  openedAt DateTime? // 오픈 누른 시각 (오픈 순서대로 정렬)
  closedAt DateTime? // 마감 누른 시각

  /// 1인당 최대 구매수량. 0이면 제한 없음 (한 사람이 쓸어담는 것 방지)
  limitPerPerson Int @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants ProductVariant[]
}

/// 사이즈/색상 조합별 재고. 옵션이 없는 상품은 size/color가 모두 null인 1개만 가짐
model ProductVariant {
  id         Int    @id @default(autoincrement())
  productId  Int
  size       String?
  color      String?
  stock      Int    @default(0)
  extraPrice Int    @default(0) // 옵션 추가금

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size, color])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  variantId Int
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
}

/// 상품 주문 1건. 배송은 하지 않고 '보관함'에 쌓였다가 정산(Settlement)으로 묶여 나감
model Order {
  id           Int       @id @default(autoincrement())
  userId       Int?
  /// 결제창 1회분마다 발급되는 값. 더블클릭·새로고침으로 같은 주문이 두 번 들어오는 것을 막음
  clientToken  String?   @unique
  settlementId Int? // 정산에 묶이면 채워짐. 없으면 아직 보관중
  buyerName    String
  buyerPhone   String
  memo         String? // 주문 메모 (옵션 요청 등)
  canceledAt   DateTime? // 취소된 주문은 매출·정산에서 제외
  cancelReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  settlement Settlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  items      OrderItem[]
}

/// 정산 = 보관중인 주문 여러 건을 묶어 한 번에 배송하는 단위. 배송비도 여기서 한 번만 부과
model Settlement {
  id             Int       @id @default(autoincrement())
  userId         Int?
  buyerName      String
  buyerPhone     String
  depositorName  String? // 입금자명 (주문자와 다를 수 있음)
  zipcode        String?
  address        String
  addressDetail  String?
  memo           String?
  paymentMethod  String    @default("계좌이체") // 계좌이체 | 카드 | 기타
  paymentStatus  String    @default("미입금") // 미입금 | 부분입금 | 입금완료 | 환불완료
  shippingStatus String    @default("접수전") // 접수전 | 접수완료 | 발송완료
  trackingNumber String?
  shippingFee    Int       @default(0)
  /// 같은 날 이미 낸 배송비를 되돌려주는 금액 (무료배송 기준을 나중에 넘긴 경우)
  shippingCredit Int       @default(0)
  discount       Int       @default(0) // 쿠폰 할인액
  couponId       Int?
  canceledAt     DateTime?
  cancelReason   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  orders Order[]
}

/// 셀러가 직접 적는 지출. 매출은 주문에서 자동으로 잡히므로 지출만 넣으면 장부가 완성됨
model Expense {
  id        Int      @id @default(autoincrement())
  spentAt   DateTime // 쓴 날짜
  category  String   @default("기타") // 사입 | 포장재 | 택배 | 광고 | 수수료 | 임대료 | 인건비 | 기타
  memo      String?
  amount    Int
  createdAt DateTime @default(now())

  @@index([spentAt])
}

/// 매달 똑같이 나가는 돈. 등록해두면 월 손익에 자동으로 반영됨
model FixedCost {
  id        Int      @id @default(autoincrement())
  name      String // 예: 창고 월세
  category  String   @default("임대료")
  amount    Int
  isActive  Boolean  @default(true)
  startedAt DateTime @default(now()) // 이 달부터 반영
  endedAt   DateTime? // 그만둔 달
  createdAt DateTime @default(now())
}

/// 쿠폰. 정산할 때 하나만 적용
model Coupon {
  id        Int       @id @default(autoincrement())
  name      String
  type      String    @default("AMOUNT") // AMOUNT(정액) | PERCENT(정률) | FREE_SHIPPING(배송비무료)
  value     Int       @default(0) // AMOUNT는 원, PERCENT는 %
  minAmount Int       @default(0) // 최소 주문금액
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  settlements Settlement[]
  pendingUsers User[]     @relation("PendingCoupon")
}

/// 주문 당시 상품 정보를 스냅샷으로 보관 (상품이 수정/삭제돼도 주문 내역 유지)
model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  variantId   Int?
  productName String
  size        String?
  color       String?
  price       Int
  cost        Int     @default(0)
  quantity    Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

/// 택배사에서 실제로 청구된 금액.
/// 보통 한 달 늦게 청구되므로(8월 청구서 = 7월 발송분)
/// 어느 달 발송분인지(month)와 청구서를 받은 달(billedMonth)을 따로 적는다
model CourierBill {
  id          Int      @id @default(autoincrement())
  /// 발송한 달 (YYYY-MM). 이 달 장부에 반영된다
  month       String   @unique
  /// 실제로 청구서를 받은 달 (보통 month 다음 달)
  billedMonth String?
  amount      Int
  memo        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
